# ============================================================
# Chronos Server local development environment
# ============================================================

# Login-service bind address
LOGIN_HOST=0.0.0.0
LOGIN_PORT=14447

# Upstream address used by gateway -> login-service
LOGIN_SERVICE_ADDR=127.0.0.1:14447

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=game_sever

# Gameplay/login policy
ADMIN_MODE=0
WAIT_LOGIN_SECS=5

# Protocol and anti-abuse
MAX_FRAME_SIZE=65536
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_MESSAGES=120
MAX_LOGIN_ATTEMPTS=8

# Transport security
TLS_ENABLED=true
TLS_CERT_PATH=certs/login-cert.pem
TLS_KEY_PATH=certs/login-key.pem

# Frame integrity (off | checksum | hmac)
INTEGRITY_MODE=hmac
HMAC_SECRET=b3464e02f95c8c1b0f72d925598b88d8b6581fc5b6e80f40724f5e91e781b0fe

# Internal service authentication
INTERNAL_PSK=4ea08a647f33ca7108186654c8cfcc7bc6a2109976dd6a49d309c0c89efb30db
