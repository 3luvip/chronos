LOGIN_SERVICE_ADDR=127.0.0.1:14447

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=game_sever

ADMIN_MODE=0
WAIT_LOGIN_SECS=5
